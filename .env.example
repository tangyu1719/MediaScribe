# 复制为 .env 或直接运行 deploy/install.ps1 / deploy/install.sh。
# 所有私密字段保持为空；安装脚本会交互询问或生成随机值。

# LLM
VOLC_API_KEY=
VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL_QA=
LLM_MODEL_REASON=

# 飞书（可选）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Docker 全栈
WEB_PORT=8000
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=superbizagent
MYSQL_USER=mediascribe
MYSQL_PASSWORD=
REDIS_PORT=6379
REDIS_PASSWORD=
MINIO_ROOT_USER=mediascribe
MINIO_ROOT_PASSWORD=
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=9091

# 应用运行时
SBA_JWT_SECRET=
SBA_DATABASE_URL=
REDIS_URL=
KB_BACKEND=milvus
MILVUS_HOST=milvus
MILVUS_COLLECTION=kb_chunks_fast
CHAT_USE_LANGGRAPH=1

# SMTP（可选）
SBA_SMTP_HOST=
SBA_SMTP_PORT=587
SBA_SMTP_USER=
SBA_SMTP_PASS=
SBA_SMTP_FROM=
SBA_SMTP_TLS=1

# 本人浏览器/小红书绑定（可选，禁止把真实值提交到 Git）
SBA_CHROME_EXPECTED_GAIA=
SBA_CHROME_EXPECTED_EMAIL=
SBA_XHS_OWNER_NICKNAME=
XHS_FAVORITES_DISPLAY_NAME=
XHS_FAVORITES_RED_ID=
XHS_FAVORITES_CREATOR_ID=
SBA_CHROME_CDP_PORT=9223
SBA_XHS_CDP_ATTACH_ONLY=1

# 模型下载
HF_ENDPOINT=https://hf-mirror.com
SBA_BGE_SNAPSHOT_PATH=

# 流程图 PDF/图片 → Mermaid（Umi-OCR HTTP 可选；未配置时自动使用 EasyOCR + Tesseract）
FLOWCHART_OCR_ENGINE=auto
FLOWCHART_UMI_OCR_URL=
FLOWCHART_MAX_PAGES=20
