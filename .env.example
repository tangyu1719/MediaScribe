# ── 火山方舟 LLM（Docker 部署：密钥仅放服务器 .env，禁止写入镜像） ──
# VOLC_API_KEY=your-ark-api-key
# VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL_QA=ep-xxxxxxxx          # 问答 endpoint id
# LLM_MODEL_REASON=ep-yyyyyyyy        # 摘要/推理 endpoint id

# ── 数据库（推荐 MariaDB/MySQL；不配置则历史仅存 history.json） ──
# 配置后：RBAC、社媒订阅、UP 画像、历史记录&任务队列 均写入同一库
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
# 本机示例（MariaDB 默认 3306，库需先 CREATE DATABASE superbizagent）：
# SBA_DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/superbizagent?charset=utf8mb4
# 历史表：pipeline_task_history（见 backend/sql/pipeline_task_history.sql）

# ── 社媒博主订阅（须 MariaDB，与上同库） ──
# SUBSCRIPTION_SCHEDULER_ENABLED=1
# SUBSCRIPTION_DEFAULT_CRON=0 8 * * *
# SUBSCRIPTION_SYNC_CONCURRENCY=3
# SUBSCRIPTION_INITIAL_FETCH_LIMIT=20
# SUBSCRIPTION_DIGEST_WAIT_SEC=1800

# 小红书收藏夹订阅（三点、水 / 9545679835；仅 Chrome 有光账号 + CDP 附着，不新开浏览器）
# XHS_FAVORITES_RED_ID=9545679835
# XHS_FAVORITES_DISPLAY_NAME=三点、水-收藏夹
# SBA_BROWSER=chrome
# SBA_CHROME_EXPECTED_GAIA=有光
# SBA_CHROME_EXPECTED_EMAIL=liyouguang2@gmail.com
# SBA_XHS_OWNER_NICKNAME=三点
# SBA_CHROME_CDP_PORT=9223
# FAVORITES_SCHEDULER_ENABLED=1
# FAVORITES_DEFAULT_CRON=0 0 * * *
# FAVORITES_FETCH_LIMIT=80
# FAVORITES_STARTUP_DELAY_SEC=45
# FAVORITES_DIGEST_WAIT_SEC=2400
# XHS_FAVORITES_CREATOR_ID=  # 可选：跳过 red_id 解析，直接指定 profile uid

# ── UP 画像五阶段（须 MariaDB + 有效小红书 Cookie + LLM） ──
# PROFILE_PIPELINE_WORKERS=2          # 独立 profile-run 线程池，不抢主链路 8 路槽位
# PROFILE_ARTICLE_CONCURRENCY=2       # 深度采样并发篇数
# PROFILE_ARTICLE_TIMEOUT_SEC=1800    # 单篇原文 MD 超时（秒）
# SBA_XHS_COOKIE_MAX_ATTEMPTS=3       # Cookie 获取失败 3 次后：关闭手机号登录弹窗 + 无状态访客模式
# SBA_BROWSER=edge                    # auto | chrome | edge — 读 Cookie/解析小红书号优先使用的浏览器
# SBA_CHROME_PROFILE=Default
# SBA_EDGE_PROFILE=Default
# SBA_CHROME_CDP_PORT=9223            # CDP 调试端口；默认用 connect_over_cdp 附着本机浏览器（无「自动测试软件控制」横幅）
# SBA_XHS_ALLOW_PERSISTENT=0          # 仅 CDP/Cookie 失败且设为 1 时才用 launch_persistent_context（会出现自动化横幅）
# SBA_XHS_SKIP_CHROME=1               # 跳过可见窗口兜底（仍尝试 CDP/Cookie 直读）
# TEST_XHS_CREATOR_ID=24位hex_user_id # 无状态无法搜到小红书号时，填博主主页 user_id（一次性）

# ── JWT 密钥（不配置则自动生成 + 持久化到 output/.sba_jwt_secret） ──
# SBA_JWT_SECRET=your-64-char-random-secret

# ── Milvus 向量库（与 docker-compose.milvus.yml 默认端口一致） ──
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
KB_BACKEND=milvus
MILVUS_COLLECTION=kb_chunks_fast
# 老项目知识库根目录（与 rag_manager_gui 一致，默认 src/agent/knowledge_base）
# SBA_KB_DIR=F:/java/AIOPS/.../src/agent/knowledge_base
# BGE 本地快照目录（须含 config.json + pytorch_model.bin；可从另一台已跑通 RAG 的机器拷贝）
# SBA_BGE_SNAPSHOT_PATH=F:/java/AIOPS/.../knowledge_base/models/models--BAAI--bge-large-zh-v1.5/snapshots/<hash>

# ── SMTP 邮件（邮箱验证码；未配置时验证码打印到控制台日志） ──
# SBA_SMTP_HOST=smtp.example.com
# SBA_SMTP_PORT=587
# SBA_SMTP_USER=notify@example.com
# SBA_SMTP_PASS=your-smtp-password
# SBA_SMTP_FROM=notify@example.com
# SBA_SMTP_TLS=1

# ── Eval 评测运维层（可选，见 backend/requirements-eval.txt） ──
# SBA_EVAL_ENABLED=1
# SBA_EVAL_SDK_ROOT=.../sdk_repos/eval
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# SBA_RAG_EVAL_ENABLED=0
# SBA_RAG_EVAL_DATASET=

# FS_ALLOW_ROOTS=F:\data\kb,F:\projects\output
