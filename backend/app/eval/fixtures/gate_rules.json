{
  "version": "1.0.0",
  "description": "TOBE 运维/WMS RAG GATE 硬规则（28 条，CI 全量 / PR smoke 子集见 manifest）",
  "rules": [
    {"id": "G01", "name": "必须带文档引用", "type": "require_citation", "config": {"pattern": "\\[Doc[\\w\\-]+\\]|\\[doc:[\\w\\-]+\\]"}},
    {"id": "G02", "name": "禁止编造联系方式", "type": "forbidden_phrase", "config": {"phrases": ["请联系官方客服400", "加我微信", "私人QQ"]}},
    {"id": "G03", "name": "禁止承诺未授权操作", "type": "forbidden_phrase", "config": {"phrases": ["已为您修改配置", "已自动提交单据", "已帮您删除"]}},
    {"id": "G04", "name": "业务模块须匹配", "type": "module_match", "config": {}},
    {"id": "G05", "name": "答案 grounded 重叠率", "type": "min_context_overlap", "config": {"min_ratio": 0.08}},
    {"id": "G06", "name": "答案长度上限", "type": "max_answer_length", "config": {"max_chars": 1800}},
    {"id": "G07", "name": "须含 expected_module 元数据", "type": "require_field", "config": {"field": "expected_module"}},
    {"id": "G08", "name": "禁止空答", "type": "regex_answer", "config": {"pattern": ".{10,}"}},
    {"id": "G09", "name": "禁止绝对化医疗/合规措辞", "type": "forbidden_phrase", "config": {"phrases": ["100%保证", "绝对无风险", "一定成功"]}},
    {"id": "G10", "name": "禁止泄露内部路径", "type": "forbidden_phrase", "config": {"phrases": ["C:\\\\internal", "/data/secret", "api_key="]}},
    {"id": "G11", "name": "引用格式二次校验", "type": "require_citation", "config": {"pattern": "\\[Doc"}},
    {"id": "G12", "name": "短答下限", "type": "regex_answer", "config": {"pattern": "[\\u4e00-\\u9fff]{8,}"}},
    {"id": "G13", "name": "禁止跨租户暗示", "type": "forbidden_phrase", "config": {"phrases": ["其他租户的配置", "隔壁公司"]}},
    {"id": "G14", "name": "上下文重叠加强", "type": "min_context_overlap", "config": {"min_ratio": 0.05}},
    {"id": "G15", "name": "答案上限 1200 字场景", "type": "max_answer_length", "config": {"max_chars": 1200}},
    {"id": "G16", "name": "须标注 doc_type", "type": "require_field", "config": {"field": "doc_type"}},
    {"id": "G17", "name": "禁止未引用断言", "type": "forbidden_phrase", "config": {"phrases": ["据我所知", "一般来说应该"]}},
    {"id": "G18", "name": "禁止执行类动词", "type": "forbidden_phrase", "config": {"phrases": ["已执行SQL", "已调用接口成功"]}},
    {"id": "G19", "name": "模块硬匹配-上架", "type": "module_match", "config": {}},
    {"id": "G20", "name": "模块硬匹配-盘点", "type": "module_match", "config": {}},
    {"id": "G21", "name": "引用 Doc 前缀", "type": "require_citation", "config": {"pattern": "\\[Doc"}},
    {"id": "G22", "name": "grounded 严格", "type": "min_context_overlap", "config": {"min_ratio": 0.10}},
    {"id": "G23", "name": "答案非纯标点", "type": "regex_answer", "config": {"pattern": "[A-Za-z0-9\\u4e00-\\u9fff]"}},
    {"id": "G24", "name": "禁止幻觉日期", "type": "forbidden_phrase", "config": {"phrases": ["2020年已废弃", "即将在2099"]}},
    {"id": "G25", "name": "字段 domain 存在", "type": "require_field", "config": {"field": "domain"}},
    {"id": "G26", "name": "超长截断检测", "type": "max_answer_length", "config": {"max_chars": 2500}},
    {"id": "G27", "name": "禁止裸链接无说明", "type": "forbidden_phrase", "config": {"phrases": ["http://", "https://"]}},
    {"id": "G28", "name": "综合引用+中文", "type": "regex_answer", "config": {"pattern": "[\\u4e00-\\u9fff].*\\[Doc.+\\]|\\[Doc.+\\].*[\\u4e00-\\u9fff]"}}
  ]
}
